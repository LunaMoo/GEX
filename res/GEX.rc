// GEX - Graphical Explorer resources
#include <winres.h>

1 ICON "gex.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GEX - Graphical Explorer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "GEX"
            VALUE "OriginalFilename", "GEX.exe"
            VALUE "ProductName", "GEX"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
